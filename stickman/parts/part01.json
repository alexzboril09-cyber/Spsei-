{
  "series": "Route 0",
  "part": 1,
  "accent": "#c6ff3d",
  "handle": "@yourchannel",
  "post_caption": "He took the last bus home. It came with rules. Part 1",
  "hashtags": ["#stickman", "#rules", "#horrorstory", "#scary", "#choices", "#storytime", "#fyp"],
  "beats": [
    { "scene": "street", "clock": "11:58 PM", "man": { "pose": "stand", "x": 0.42 },
      "say": "11:58 PM. You missed every bus home.", "hl": ["missed"], "sfx": "whoosh" },
    { "scene": "street", "bus": "arrive", "man": { "pose": "stand", "x": 0.42 },
      "say": "Except one. Route Zero.", "hl": ["Zero."], "sfx": "brakes" },
    { "scene": "street", "bus": "stay", "man": { "from": 0.42, "to": 0.15 },
      "say": "There's no Route Zero on the map.", "hl": ["no"] },
    { "scene": "bus", "man": { "from": 0.0, "to": 0.4 }, "sign": "NEXT STOP: --",
      "say": "The bus is empty. A card is taped to the seat.", "hl": ["card"] },
    { "scene": "rule", "num": 1, "text": "Never sit in the back row", "icon": "seat",
      "say": "Rule one. Never sit in the back row.", "hl": ["back", "row."], "sfx": "click" },
    { "scene": "rule", "num": 2, "text": "If the driver asks your name, lie", "icon": "name",
      "say": "Rule two. If the driver asks your name, lie.", "hl": ["lie."], "sfx": "click" },
    { "scene": "rule", "num": 3, "text": "After 12:13 don't look at the windows", "icon": "window",
      "say": "Rule three. After 12:13, don't look at the windows.", "hl": ["12:13,", "windows."], "sfx": "click" },
    { "scene": "bus", "clock": "12:04 AM", "man": { "pose": "sit", "x": 0.4 },
      "say": "You sit in the middle. Easy.", "hl": ["middle."] },
    { "scene": "phone", "contact": "Mom", "time": "12:06 AM", "sfx": "buzz",
      "messages": [
        { "from": "me", "text": "on the bus, home soon" },
        { "from": "them", "text": "what bus?? the last one left at 11:40" }
      ],
      "say": "Your phone buzzes. The last bus left at 11:40.", "hl": ["11:40."] },
    { "scene": "face", "expr": "worried",
      "say": "So what bus are you on?", "hl": ["what", "bus"], "sfx": "heartbeat" },
    { "scene": "bus", "clock": "12:09 AM", "driver": true, "man": { "pose": "sit", "x": 0.4 },
      "say": "The driver speaks. Without turning around.", "hl": ["without"] },
    { "scene": "text", "lines": ["WHAT'S", "YOUR NAME?"], "size": 130, "shake": 1,
      "say": "What's your name?", "hl": ["name?"], "sfx": "sting" },
    { "scene": "face", "expr": "worried",
      "say": "You lie. You say: Mark.", "hl": ["lie.", "mark."] },
    { "scene": "bus_window", "clock": "12:13 AM", "clock_alert": true, "hands": 0, "flicker": true,
      "say": "12:13. The lights flicker.", "hl": ["12:13."], "sfx": "static" },
    { "scene": "bus_window", "hands": 4, "zoom": true,
      "say": "Something is tapping on the window. Right next to your head.", "hl": ["tapping"], "sfx": "tap" },
    { "scene": "phone", "contact": "Unknown", "time": "12:14 AM", "sfx": "buzz", "typing": true,
      "messages": [
        { "from": "them", "text": "it's Mark.", "creepy": true },
        { "from": "them", "text": "let me in.", "creepy": true }
      ],
      "say": "A text from an unknown number. It's Mark. Let me in.", "hl": ["mark.", "let", "in."] },
    { "scene": "face", "expr": "scared", "shake": 1,
      "say": "The name you made up... is outside.", "hl": ["made", "up..."] },
    { "scene": "bus", "man": { "pose": "sit", "x": 0.4 }, "back_figure": "appear", "flicker": true,
      "say": "And in the back row... someone just sat down.", "hl": ["back", "row..."], "sfx": "sting" },
    { "scene": "choice", "clock": "12:15 AM",
      "question": "Pull the stop cord or stay on the bus?",
      "a": "Pull the cord and get off", "b": "Stay seated, don't look",
      "next": "PART 2",
      "say": "Pull the cord and get off? Or stay seated? Comment A or B.", "hl": ["A", "B."], "sfx": "riser" }
  ]
